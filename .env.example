# Generation saglayicisi: local | gemini
PROVIDER=local

# PROVIDER=gemini icin gerekli (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# PROVIDER=local icin GGUF model yolu
LOCAL_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
LOCAL_GPU_LAYERS=-1
LOCAL_CTX=8192

# Embedding (her zaman lokal, GPU)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DEVICE=cuda
EMBED_BATCH=8
# 4 GB VRAM icin guvenli; maddelerin %99.7si zaten bu sinirin altinda
EMBED_MAX_SEQ=512

# --- yeniden siralama ---
# Kapatmak icin RERANK=0
RERANK=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ADAY=12
RERANK_MAX_SEQ=256
RERANK_BATCH=12

# Scraper nezaketi
SCRAPE_DELAY=1.5
SCRAPE_CONTACT=btaygurt@gmail.com
